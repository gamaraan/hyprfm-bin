pkgbase = hyprfm-bin
	pkgdesc = A lightweight Qt6/QML file manager for Hyprland (release AppImage, bundled Qt)
	pkgver = 0.7.1
	pkgrel = 1
	url = https://github.com/soyeb-jim285/hyprfm
	arch = x86_64
	license = MIT
	makedepends = 7zip
	depends = dbus
	depends = e2fsprogs
	depends = fontconfig
	depends = freetype2
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = gvfs
	depends = libglvnd
	depends = libx11
	depends = libxcb
	depends = libxkbcommon
	depends = wayland
	depends = xdg-utils
	depends = zlib
	optdepends = wl-clipboard: clipboard support via wl-copy and wl-paste
	optdepends = fd: fast recursive search (falls back to a built-in walker)
	optdepends = bat: syntax-highlighted text previews
	optdepends = md4c: rendered Markdown previews (via md2html)
	optdepends = gvfs-smb: SMB/CIFS remote browsing support
	optdepends = gvfs-mtp: Android phones (MTP) in the sidebar
	optdepends = ffmpeg: video thumbnails and audio/video metadata (via ffprobe)
	optdepends = poppler: PDF thumbnails, previews, and metadata (via pdftoppm/pdfinfo)
	optdepends = perl-image-exiftool: EXIF metadata for images (via exiftool)
	optdepends = udisks2: mount/unmount devices from sidebar
	provides = hyprfm
	conflicts = hyprfm
	conflicts = hyprfm-git
	noextract = HyprFM-v0.7.1-x86_64.AppImage
	options = !strip
	options = !debug
	source = HyprFM-v0.7.1-x86_64.AppImage::https://github.com/soyeb-jim285/hyprfm/releases/download/v0.7.1/HyprFM-v0.7.1-x86_64.AppImage
	source = LICENSE-0.7.1::https://raw.githubusercontent.com/soyeb-jim285/hyprfm/v0.7.1/LICENSE
	sha256sums = e27ad1aa12ba6e6c3b0e850081592dfdea895ec0beeef07e2f854a1b23e3e9df
	sha256sums = 8f8b292b6ebbda3e2a3ec0fc0f7c1146916e2821e671bcb3c92cde2afab60fab

pkgname = hyprfm-bin
